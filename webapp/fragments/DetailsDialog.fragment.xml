<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="projectDetailsDialog" title="{projects>name}">
        <content>
            <!-- This is where your details live -->
            <VBox  id="vBoxProjectDetails" class="sapUiMediumMargin">
                <Text id="txtProjectDescription" text="{projects>description}" class="sapUiSmallMarginBottom" />
                <!-- Embedded Video -->
                <FlexBox id="videoContainer" justifyContent="Center" alignItems="Center" width="100%" visible="{= ${projects>videoName} ? true : false }" >
                    <core:HTML 
                        id="projectVideo" 
                        content='&lt;video width="70%" height="50%" controls&gt;
                                    &lt;source src="videos/{projects>videoName}" type="video/mp4"&gt;
                                    Your browser does not support the video tag.
                                    &lt;/video&gt;' />
                </FlexBox>

                <!-- Image Slideshow (Carousel) -->
                <!-- Visible only if the project has images -->
                <Carousel 
                    id="projectImageCarousel" 
                    width="100%" 
                    height="300px"
                    visible="{= ${projects>images} ? true : false }"
                    pages="{projects>images}">
                    <pages>
                        <Image id="image"
                            src="images/{projects>}" 
                            densityAware="false"
                            width="100%" 
                            height="100%" />
                    </pages>
                </Carousel>
            </VBox>
        </content>
        <beginButton>
            <!-- A button inside the dialog footer to close it -->
            <Button id="btnCloseDetails" text="Close" press="onCloseDetails" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>